CREATE TABLE collection_backup_commits (
    operation_id TEXT NOT NULL PRIMARY KEY,
    source_id INTEGER NOT NULL
);

markCommitted:
INSERT INTO collection_backup_commits(operation_id, source_id) VALUES (:operation_id, :source_id);

isCommitted:
SELECT count(*) FROM collection_backup_commits WHERE operation_id = :operation_id;

resetRestoredChapterSync:
UPDATE chapters SET is_syncing = 0 WHERE manga_id IN (SELECT _id FROM mangas WHERE source = :source_id);
