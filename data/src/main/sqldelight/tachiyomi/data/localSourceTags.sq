CREATE TABLE local_source_tags (
    source_id INTEGER NOT NULL,
    tag_id INTEGER NOT NULL REFERENCES local_tags(id) ON DELETE CASCADE,
    PRIMARY KEY (source_id, tag_id)
);

CREATE INDEX local_source_tags_tag_index ON local_source_tags(tag_id);

getSourceTags:
SELECT local_tags.id, local_tags.name, local_tags.normalized_name
FROM local_tags JOIN local_source_tags ON local_source_tags.tag_id = local_tags.id
WHERE local_source_tags.source_id = :source_id
ORDER BY local_tags.normalized_name;

insertSourceTag:
INSERT OR IGNORE INTO local_source_tags(source_id, tag_id)
SELECT :source_id, id FROM local_tags WHERE normalized_name = :normalized_name;

mergeSourceTags:
INSERT OR IGNORE INTO local_source_tags(source_id, tag_id)
SELECT source_id, :target_id FROM local_source_tags WHERE tag_id = :old_id;


